# --- Database (Postgres) ---------------------------------------------------
# Single Postgres URL used everywhere — local dev AND production.
# Recommended: a free Neon project (https://neon.tech). Same hosted
# Postgres runs in both environments, eliminating the SQLite-vs-Postgres
# divergence we used to have.
#
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# --- Admin gate ------------------------------------------------------------
# Any non-empty string. Required to access /admin and admin API endpoints.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN="change-me"

# --- GHIN credentials ------------------------------------------------------
# Email or GHIN number used to log in.
GHIN_USERNAME=""
GHIN_PASSWORD=""

# --- Vercel Cron (optional) ------------------------------------------------
# Vercel auto-injects this in cron requests; the periodic sync route
# verifies it. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Site URL (recommended) -----------------------------------------------
# Used to resolve absolute URLs in <meta> tags (OpenGraph image, canonical
# link, etc.). Set to your production domain on Vercel; defaults to
# http://localhost:3000 in dev so things work without configuration.
# Example: https://bdt-golf-network.vercel.app
NEXT_PUBLIC_SITE_URL=""
