# --- Database (Postgres) ---------------------------------------------------
# Any Postgres (the driver is node-postgres). The server applies the
# drizzle/ migrations itself on every start.
#
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=""

# One-time import: while DATABASE_URL has no golfers, every row is copied from
# this database on start. Remove it afterwards.
# SOURCE_DATABASE_URL=""

# --- Admin gate ------------------------------------------------------------
# Any non-empty string. Required to access /admin and admin API endpoints.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN="change-me"

# --- GHIN credentials ------------------------------------------------------
# Email or GHIN number used to log in.
GHIN_USERNAME=""
GHIN_PASSWORD=""

# --- Email (sign-in links) --------------------------------------------------
# Golfers sign in with a link sent to their email. Any service that accepts
# Resend's JSON shape works: POST {from, to, subject, text} with a bearer key.
# Leave EMAIL_API_KEY empty to send nothing: links are then written to the
# server log, and an admin can copy one per golfer from the control room.
EMAIL_API_KEY=""
# The sender, on a domain the service has verified.
# Example: BDT Golf Network <golf@example.com>
EMAIL_FROM=""
# Only for a service other than Resend. Defaults to https://api.resend.com/emails
# Production uses Remail: https://remail.foo/v1/emails
# EMAIL_API_URL=""

# --- Push notifications (optional) -----------------------------------------
# A VAPID key pair lets the site send push notifications to phones and
# browsers. Generate one with: npx web-push generate-vapid-keys
# Leave both empty to turn push off. Changing them later silently breaks every
# existing subscription, so set them once.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact for the push services: a mailto: or https: address.
# Defaults to NEXT_PUBLIC_SITE_URL.
# VAPID_SUBJECT="mailto:you@example.com"

# --- External scheduler (optional) -----------------------------------------
# The server syncs the roster itself twice a day. Set this only to call
# GET /api/cron/sync from your own scheduler (Authorization: Bearer <value>).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Backups (optional) ----------------------------------------------------
# Lets an off-site job download the whole database from GET /api/backup
# (Authorization: Bearer <value>). Unset, the route answers 404.
# Generate with: openssl rand -hex 32
BACKUP_TOKEN=""

# --- Site URL (recommended) -----------------------------------------------
# Used to resolve absolute URLs in <meta> tags (OpenGraph image, canonical
# link, etc.) and the links in emails (sign-in, scoreboard, unsubscribe).
# Defaults to http://localhost:3000 in dev.
# Example: https://bdt.ash10.dev
NEXT_PUBLIC_SITE_URL=""
