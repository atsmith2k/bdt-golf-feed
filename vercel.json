{
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "src/app/api/sync/route.ts": { "maxDuration": 60 },
    "src/app/api/sync/[ghin]/route.ts": { "maxDuration": 60 },
    "src/app/api/backfill/route.ts": { "maxDuration": 60 },
    "src/app/api/backfill/[ghin]/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/sync/route.ts": { "maxDuration": 60 }
  }
}
